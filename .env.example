# ============================================================================
# CONFIGURAÇÃO DO APP DE FINANÇAS PESSOAIS
# ============================================================================

# DATABASE
DATABASE_URL=postgresql://usuario:senha@localhost:5432/financas_pessoais
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financas_pessoais
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# GOOGLE DRIVE & OAUTH
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# IDs DAS PASTAS NO GOOGLE DRIVE
# DRIVE_FINANCAS_FOLDER_ID é obrigatório para listar a pasta principal.
# Importações e backups são opcionais: se ficarem vazios/placeholder, usam DRIVE_FINANCAS_FOLDER_ID.
DRIVE_FINANCAS_FOLDER_ID=1RRSu1XUV72b68AM1wvT3MIEEGm-MddOK
DRIVE_IMPORTACOES_FOLDER_ID=seu_folder_id_aqui
DRIVE_BACKUPS_FOLDER_ID=seu_folder_id_aqui

# BACKEND
NODE_ENV=development
PORT=3000
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# FRONTEND
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# CRONJOB (sincronização automática)
CRON_SYNC_SCHEDULE=0 */6 * * * (a cada 6 horas)
ENABLE_AUTO_SYNC=true

# LOGGING
LOG_LEVEL=debug
